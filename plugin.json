{
  "name": "adb-plugin-tempvoice",
  "displayName": "Temp Voice Channels",
  "version": "1.2.1",
  "description": "Join-to-create temporary voice channels with configurable defaults, owner controls under /voice, and occupancy-aware cleanup.",
  "author": "DeadIndian",
  "main": "index.js",
  "requiresRestart": true,
  "manifestVersion": 2,
  "process": {
    "model": "persistent",
    "maxExecutionMs": 15000,
    "memoryMb": 256,
    "persistentReason": "Runs un-isolated (system:raw-client) to create and manage voice channels on voiceStateUpdate events (guild.channels.create, channel.edit, channel.delete), and to enforce permissions and bitrate — the guild.channels API and voice state inspection are outside the sandboxed RPC surface."
  },
  "capabilities": {
    "system": ["raw-client"],
    "storage": ["own-collection"],
    "discord": ["ManageChannels", "ManageRoles", "ViewChannel", "SendMessages", "Connect", "Speak", "MoveMembers"],
    "hooks": ["subscribe"]
  },
  "permissions": {
    "system": ["raw-client"],
    "storage": ["own-collection"],
    "discord": ["ManageChannels", "ManageRoles", "ViewChannel", "SendMessages", "Connect", "Speak", "MoveMembers"],
    "hooks": ["subscribe"],
    "network": { "outbound": [] },
    "filesystem": { "read": [], "write": [] },
    "childProcess": false,
    "nativeAddons": false
  },
  "declaredDependencies": [{ "package": "node-cron", "version": "^4.6.0" }],
  "discordPermissions": ["ManageChannels", "ManageRoles", "ViewChannel", "SendMessages", "Connect", "Speak", "MoveMembers"],
  "webUi": {
    "memberPages": [
      {
        "path": "/me/channels",
        "label": "My Temp Channels",
        "icon": "Mic",
        "source": {
          "model": "TempVoiceChannel",
          "scope": "member",
          "sort": { "createdAt": -1 },
          "limit": 50
        },
        "view": {
          "type": "list",
          "title": "channelId",
          "badge": "locked",
          "empty": "You have no active temp voice channels in this server."
        }
      }
    ]
  },
  "engines": {
    "core": ">=2.0.0",
    "plugins": { "administration": ">=2.0.0" }
  },
  "settings": {
    "commandPermissions": true,
    "schema": [
      { "key": "creationChannelId", "type": "channel", "label": "Join-to-create channel" },
      { "key": "categoryId", "type": "string", "label": "Temp VC category ID" },
      { "key": "nameTemplate", "type": "string", "label": "Channel name template" },
      { "key": "autoDeleteDelay", "type": "number", "label": "Auto-delete delay (minutes)" },
      { "key": "maxChannels", "type": "number", "label": "Max temp channels" },
      { "key": "bitrateDefault", "type": "number", "label": "Default bitrate" },
      { "key": "userLimitDefault", "type": "number", "label": "Default user limit" }
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "creationChannelId": {
        "type": ["string", "null"],
        "default": null,
        "description": "Discord snowflake ID of the designated voice channel where temporary voice channels are spawned"
      },
      "categoryId": {
        "type": ["string", "null"],
        "default": null,
        "description": "Discord snowflake ID of the category where temporary channels are created"
      },
      "nameTemplate": {
        "type": "string",
        "default": "{username}'s channel",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "\\{(?:username|user)\\}",
        "description": "Template for temporary channel names. Must include {username} or {user}."
      },
      "autoDeleteDelay": {
        "type": "integer",
        "default": 30,
        "minimum": 0,
        "description": "Delay in minutes before empty temporary channels are auto-deleted (0 = disabled)"
      },
      "maxChannels": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Maximum number of temporary channels allowed per guild (0 = unlimited)"
      },
      "bitrateDefault": {
        "type": "integer",
        "default": 64000,
        "minimum": 8000,
        "maximum": 384000,
        "description": "Default bitrate for new temporary channels (bps), capped by the guild's current tier"
      },
      "userLimitDefault": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 99,
        "description": "Default user limit for temporary channels (0 = none)"
      }
    },
    "required": []
  }
}
